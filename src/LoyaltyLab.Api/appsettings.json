{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LoyaltyLab": "Data Source=loyaltylab.db"
  },
  "DemoClock": {
    "Enabled": false
  },
  "PaymentSim": {
    "BaseUrl": "http://localhost:5190/"
  },
  "Outbox": {
    "MaxAttempts": 5,
    "PollIntervalMs": 250,
    "Dispatcher": {
      "Enabled": true
    }
  },
  "SagaRecovery": {
    "PollIntervalMs": 1000,
    "Enabled": true
  }
}
